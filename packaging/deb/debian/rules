#!/usr/bin/make -f
# SPDX-FileCopyrightText: 2026 sorrelfox and Helikodu contributors
# SPDX-License-Identifier: GPL-3.0-or-later

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
# Cargo is started by Meson; at most this many compiler processes at once.
export CARGO_BUILD_JOBS ?= 4

%:
	dh $@ --buildsystem=meson

# The release tarball vendors every crate, so Cargo builds offline. The
# system SQLite is used (Debian 13 and Ubuntu 26.04 have 3.46 with FTS5).
override_dh_auto_configure:
	dh_auto_configure -- -Doffline=true -Dbundled_sqlite=false -Dvgmstream=false

# dh_clean would delete the vendored crates' Cargo.toml.orig files, whose
# checksums Cargo checks.
override_dh_clean:
	dh_clean -XCargo.toml.orig

# Rust release binaries carry no DWARF of their own that dwz could compress.
override_dh_dwz:

# Only the package itself is published, no separate debug symbols package.
override_dh_strip:
	dh_strip --no-automatic-dbgsym
