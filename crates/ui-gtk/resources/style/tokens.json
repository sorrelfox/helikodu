      "patterns": [
        "disc: shape circle, radius 21% of the side, centred at 68% / 34%",
        "diagonal: ground above-left, shape below-right of the 135 degree diagonal",
        "arch: half-discs centred at 50% / 100%: detail radius 38%, shape ring to 56%",
        "stripes: vertical stripes, shape 6% wide, every 20%",
        "horizon: ground to 62%, detail band 62-66%, shape below",
        "two discs: detail radius 12% at 30% / 70%, shape radius 30% at 62% / 40%"
