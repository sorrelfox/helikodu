    "accent": {
      "default": "#F0B23C",
      "onAccent": "#15120B",
      "source": "Settings portal accent-color; default when the portal reports none.",
      "rules": {
        "mix": "mix(a, b, t) = OKLab interpolation, t = share of b",
        "ensureContrast": "Move the colour toward white (dark surfaces) or black (light surfaces) in 5% OKLab steps until WCAG contrast against the given surface reaches the minimum.",
        "dark.fill": "ensureContrast(accent, pane, 3.0)",
        "dark.text": "ensureContrast(mix(accent, #FFFFFF, 0.18), hover, 4.5)",
        "dark.sel": "accent at 16% alpha",
        "light.fill": "ensureContrast(mix(accent, #000000, 0.20), pane, 3.0)",
        "light.text": "ensureContrast(mix(accent, #000000, 0.45), hover, 4.5)",
        "light.sel": "accent at 24% alpha",
        "glass.fill": "ensureContrast(accent, glass.bg, 3.0)",
        "onAccent": "#15120B when its contrast on the fill is at least 4.5, otherwise #FFFFFF"
      },
      "examples": {
        "Amber #F0B23C": {
          "dark.fill": "#F0B23C",
          "dark.text": "#F3C169",
          "light.fill": "#B2832A",
          "light.text": "#6A4D15",
          "dark.selOnPane": "#3D3424",
          "light.selOnPane": "#F6E7C9"
        },
        "Blue #6CA8F0": {
          "dark.fill": "#6CA8F0",
          "dark.text": "#87B8F4",
          "light.fill": "#4E7CB2",
          "light.text": "#2C486A",
          "dark.selOnPane": "#283241",
          "light.selOnPane": "#D6E5F5"
        },
        "Green #63CB8F": {
          "dark.fill": "#63CB8F",
          "dark.text": "#83D5A3",
          "light.fill": "#479669",
          "light.text": "#28593C",
          "dark.selOnPane": "#273832",
          "light.selOnPane": "#D4EDDD"
        },
        "Violet #B59DF5": {
          "dark.fill": "#B59DF5",
          "dark.text": "#C2AFF8",
          "light.fill": "#8673B6",
          "light.text": "#4E436D",
          "dark.selOnPane": "#343142",
          "light.selOnPane": "#E8E2F6"
        }
      }
    },
