<!-- The album page: the hero, then the track table beside the details column. -->
<interface domain="helikodu">
  <template class="HkAlbumPage" parent="GtkBox">
    <property name="orientation">vertical</property>
    <child>
      <object class="GtkScrolledWindow">
        <property name="vexpand">True</property>
        <property name="hscrollbar-policy">never</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkBox" id="hero">
                <property name="spacing">28</property>
                <style><class name="hk-hero"/></style>
                <child>
                  <object class="HkCoverArt" id="cover">
                    <property name="valign">start</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="valign">center</property>
                    <property name="hexpand">True</property>
                    <child>
                      <object class="GtkLabel" id="section">
                        <property name="label" translatable="yes">Album</property>
                        <property name="xalign">0</property>
                        <style><class name="hk-section-label"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="title">
                        <property name="xalign">0</property>
                        <property name="ellipsize">end</property>
                        <property name="margin-top">4</property>
                        <style><class name="hk-hero-title"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">6</property>
                        <property name="margin-top">4</property>
                        <child>
                          <object class="GtkLabel" id="artist">
                            <property name="xalign">0</property>
                            <property name="ellipsize">end</property>
                            <style><class name="hk-strong"/></style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="meta">
                            <property name="xalign">0</property>
                            <property name="ellipsize">end</property>
                            <style>
                              <class name="hk-t3"/>
                              <class name="hk-numeric"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="HkWrapBox" id="badges">
                        <property name="spacing">6</property>
                        <property name="row-spacing">6</property>
                        <property name="margin-top">14</property>
                      </object>
                    </child>
                    <child>
                      <object class="HkWrapBox" id="label_chips">
                        <property name="spacing">6</property>
                        <property name="row-spacing">6</property>
                        <property name="margin-top">10</property>
                      </object>
                    </child>
                    <child>
                      <object class="HkWrapBox">
                        <property name="spacing">8</property>
                        <property name="row-spacing">8</property>
                        <property name="margin-top">18</property>
                        <child>
                          <object class="GtkButton" id="play">
                            <style>
                              <class name="hk-btn"/>
                              <class name="primary"/>
                            </style>
                            <child>
                              <object class="GtkBox">
                                <property name="spacing">8</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">media-playback-start-symbolic</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="play_label">
                                    <property name="label" translatable="yes">Play</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="shuffle">
                            <style><class name="hk-btn"/></style>
                            <child>
                              <object class="GtkBox">
                                <property name="spacing">8</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">media-playlist-shuffle-symbolic</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Shuffle</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="restart">
                            <property name="visible">False</property>
                            <property name="action-name">album-page.restart</property>
                            <style><class name="hk-btn"/></style>
                            <child>
                              <object class="GtkBox">
                                <property name="spacing">8</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">view-refresh-symbolic</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Start again</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton">
                            <property name="action-name">album-page.enqueue</property>
                            <style><class name="hk-btn"/></style>
                            <child>
                              <object class="GtkBox">
                                <property name="spacing">8</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">list-add-symbolic</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Add to queue</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton">
                            <property name="icon-name">view-more-symbolic</property>
                            <property name="action-name">album-page.more</property>
                            <property name="tooltip-text" translatable="yes">More</property>
                            <accessibility>
                              <property name="label" translatable="yes">More</property>
                            </accessibility>
                            <style>
                              <class name="hk-btn"/>
                              <class name="icon-only"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox" id="progress">
                            <property name="visible">False</property>
                            <property name="spacing">10</property>
                            <property name="margin-start">12</property>
                            <property name="valign">center</property>
                            <child>
                              <object class="GtkLevelBar" id="heard">
                                <property name="width-request">120</property>
                                <property name="valign">center</property>
                                <style><class name="hk-heard"/></style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="heard_text">
                                <property name="wrap">True</property>
                                <property name="xalign">0</property>
                                <style>
                                  <class name="hk-t3"/>
                                  <class name="hk-numeric"/>
                                  <class name="hk-heard-text"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="body">
                <child>
                  <object class="GtkBox" id="track_list">
                    <property name="orientation">vertical</property>
                    <property name="hexpand">True</property>
                    <property name="margin-start">24</property>
                    <property name="margin-end">20</property>
                    <property name="margin-top">14</property>
                    <property name="margin-bottom">24</property>
                    <child>
                      <object class="GtkBox" id="header">
                        <property name="spacing">14</property>
                        <style><class name="hk-table-header"/></style>
                        <child>
                          <object class="GtkButton" id="number_sort">
                            <style><class name="hk-header-button"/></style>
                            <child>
                              <object class="GtkLabel" id="number_column">
                                <property name="label">#</property>
                                <property name="width-request">24</property>
                                <property name="xalign">1</property>
                                <style><class name="hk-section-label"/></style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="title_sort">
                            <property name="hexpand">True</property>
                            <style><class name="hk-header-button"/></style>
                            <child>
                              <object class="GtkLabel" id="title_column">
                                <property name="label" translatable="yes">Title</property>
                                <property name="hexpand">True</property>
                                <property name="xalign">0</property>
                                <style><class name="hk-section-label"/></style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="plays_sort">
                            <style><class name="hk-header-button"/></style>
                            <child>
                              <object class="GtkLabel" id="plays_column">
                                <property name="label" translatable="yes">Plays</property>
                                <property name="width-request">56</property>
                                <property name="xalign">1</property>
                                <style><class name="hk-section-label"/></style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="rating_sort">
                            <style><class name="hk-header-button"/></style>
                            <child>
                              <object class="GtkLabel" id="rating_column">
                                <property name="label" translatable="yes">Rating</property>
                                <property name="width-request">74</property>
                                <property name="xalign">0</property>
                                <style><class name="hk-section-label"/></style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="length_sort">
                            <style><class name="hk-header-button"/></style>
                            <child>
                              <object class="GtkLabel" id="length_column">
                                <property name="label" translatable="yes">Length</property>
                                <property name="width-request">48</property>
                                <property name="xalign">1</property>
                                <style><class name="hk-section-label"/></style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkListBox" id="tracks">
                        <property name="selection-mode">single</property>
                        <property name="activate-on-single-click">false</property>
                        <property name="margin-top">6</property>
                        <accessibility>
                          <property name="label" translatable="yes">Tracks</property>
                        </accessibility>
                        <style><class name="hk-tracks"/></style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="details_box">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <style><class name="hk-details"/></style>
                    <child>
                      <object class="GtkBox" id="track_section">
                        <property name="visible">False</property>
                        <property name="margin-bottom">12</property>
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <child>
                          <object class="GtkLabel" id="track_heading">
                            <property name="xalign">0</property>
                            <property name="wrap">True</property>
                            <property name="wrap-mode">word-char</property>
                            <style><class name="hk-section-label"/></style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkGrid" id="track_details">
                            <property name="column-spacing">12</property>
                            <property name="row-spacing">10</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkSeparator">
                            <property name="margin-top">8</property>
                            <style><class name="hk-divider"/></style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Details</property>
                        <property name="xalign">0</property>
                        <style><class name="hk-section-label"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkGrid" id="details">
                        <property name="column-spacing">12</property>
                        <property name="row-spacing">10</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSeparator">
                        <property name="margin-top">8</property>
                        <style><class name="hk-divider"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">12</property>
                        <property name="margin-top">4</property>
                        <child>
                          <object class="GtkLabel" id="kind_label">
                            <property name="label" translatable="yes">Kind</property>
                            <property name="xalign">0</property>
                            <property name="hexpand">True</property>
                            <style><class name="hk-t3"/></style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkDropDown" id="kind">
                            <accessibility>
                              <relation name="labelled-by">kind_label</relation>
                            </accessibility>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="kind_text">
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <style><class name="hk-t3"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">8</property>
                        <property name="margin-top">12</property>
                        <child>
                          <object class="GtkButton">
                            <property name="label" translatable="yes">Edit tags</property>
                            <property name="action-name">album-page.edit-tags</property>
                            <style>
                              <class name="hk-btn"/>
                              <class name="small"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton">
                            <property name="label" translatable="yes">Open folder</property>
                            <property name="action-name">album-page.open-folder</property>
                            <style>
                              <class name="hk-btn"/>
                              <class name="small"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
